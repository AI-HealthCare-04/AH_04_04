<?xml version="1.0" encoding="utf-8"?><!--
   백업·기기 이전 규칙 (API 31+).
   https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- 세션 저장소 제외(#358 리뷰): Keystore 키가 기기 종속이라 복원본은 해독 불가 —
             세션 토큰 암호문·user_id 를 클라우드 백업에서 뺀다. -->
        <exclude domain="sharedpref" path="aigo_session.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- 기기 이전도 동일: 새 기기의 Keystore 에는 키가 없어 세션은 어차피 재로그인이다. -->
        <exclude domain="sharedpref" path="aigo_session.xml" />
    </device-transfer>
</data-extraction-rules>
